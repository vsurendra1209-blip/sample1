pipeline{
    agent {
        label "java-slave"
    } 
    stages {

        stage ("hostname") {
            steps {
                sh 'hostname -i'
            }
        }
        stage ("build") {
            steps {
                echo "build stage"
            }
        }
        stage ("test") {
            steps {
                echo "test stage"
            }
        }
        stage ("scan") {
            steps {
                echo "scan stage"
            }
        }
    }
}
