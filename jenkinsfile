pipeline{
    agent {
        label "java-slave"
    }
    stages{
        stage("build") {
            steps{
                retry(2) {
                    echo "printing a new msg"
                }
                echo "after retying msg"
            }
            
        }
        stage("scaning"){
                steps {
                    echo "scanning stage"
                    error "this will give an error"

                }
            }

    }
}